# Copy to deploy/.env and edit. Compose reads it automatically.

# The site address Caddy serves.
#   seg.example.com  → automatic TLS from Let's Encrypt (needs public DNS and ports 80/443)
#   :80              → plain http, for a local run
SEG_SITE_ADDRESS=:80

# Where Let's Encrypt sends expiry warnings. Unused when SEG_SITE_ADDRESS is `:80`.
SEG_ACME_EMAIL=admin@example.com

# Host ports to publish. Change these if something already owns 80/443 on the box.
SEG_HTTP_PORT=80
SEG_HTTPS_PORT=443
