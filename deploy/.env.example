# Copy to deploy/.env and edit. Compose reads it automatically.

# ── external access ────────────────────────────────────────────────────────────
# The public DNS name. Caddy provisions a Let's Encrypt certificate for it
# automatically, which needs public DNS pointing at this box and ports 80/443 open.
#   seg.example.com  → a real, publicly trusted certificate
#   localhost        → the local default; Caddy signs it with its own CA instead
SEG_SITE_ADDRESS=localhost

# Where Let's Encrypt sends expiry warnings. Unused when SEG_SITE_ADDRESS is `localhost`.
SEG_ACME_EMAIL=admin@example.com

# ── LAN access ─────────────────────────────────────────────────────────────────
# How the box is reached from inside the network. Let's Encrypt cannot issue a
# certificate for a private address, so this one is signed by Caddy's own CA and LAN
# clients have to trust that CA's root — see "LAN access" in README.md.
#   192.168.1.50  → the box's LAN IP
#   seg.lan       → an internal DNS name, if you have one (nicer: no cert warning
#                   about the address itself, and SNI works normally)
SEG_LAN_ADDRESS=127.0.0.1

# Host ports to publish. Change these if something already owns 80/443 on the box.
# Note that moving 443 breaks the http→https redirect, which always points at 443.
SEG_HTTP_PORT=80
SEG_HTTPS_PORT=443

# ── capacity ───────────────────────────────────────────────────────────────────
# How many matches may run at once. Each one gets its own worker thread, so this is
# really a question about cores: `pnpm --filter @seg/tools bench:netcode:concurrency`
# reports how many matches one thread carries before ticks arrive late, and the cap
# wants to be roughly that figure times the number of cores you are willing to spend.
#
# At the cap, `lobby.start` is refused with a message the host can act on and the lobby
# survives — the server never admits a match it cannot tick on time.
SEG_MAX_MATCHES=32
