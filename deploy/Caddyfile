# Caddy: TLS termination, static file serving, and the reverse proxy to the Node server.
# planning/10 §7.
#
# Two site blocks serve the same application over two different certificates:
#
#   SEG_SITE_ADDRESS — the public DNS name. Caddy provisions a Let's Encrypt certificate
#                      automatically. Reachable from the internet, trusted by every client.
#   SEG_LAN_ADDRESS  — the LAN name(s)/IP. Let's Encrypt cannot issue for a private address,
#                      so this block uses `tls internal`: Caddy's own CA signs a certificate
#                      on the spot. LAN clients must trust that CA's root or they get the
#                      browser warning — see deploy/README.md.
#
# Everything on :80 is redirected to https, so the two blocks are the only way in.
{
	email {$SEG_ACME_EMAIL:admin@example.com}
	# Nothing needs the admin API, and leaving it listening inside the container is a
	# config-rewrite endpoint nobody is watching.
	admin off

	# Load-bearing for LAN access by IP. A client opening https://192.168.1.50 sends no
	# SNI — the TLS spec forbids an IP literal there — so Caddy has no name to select a
	# certificate with. Its fallback is the IP the connection arrived on, which inside a
	# container is the docker bridge address (172.x), never the LAN IP the certificate is
	# for. The handshake then fails outright with no way for the user to click through.
	# This names the certificate to serve when SNI is absent, which makes the bare-IP LAN
	# URL work. Clients using a DNS name always send SNI and are unaffected.
	default_sni {$SEG_LAN_ADDRESS:127.0.0.1}
}

# ── the application ────────────────────────────────────────────────────────────
# Imported by both site blocks. Everything that is the same regardless of which
# certificate terminated the connection lives here; the blocks below hold only the
# parts that genuinely differ (which is the TLS issuer, and HSTS).
(seg-app) {
	encode zstd gzip

	# `server` is the compose service name. reverse_proxy handles the WebSocket
	# upgrade itself — no special casing needed.
	handle /api/* {
		reverse_proxy server:8787
	}

	handle /health {
		reverse_proxy server:8787
	}

	# The realtime gateway (planning/02) will live here. The route exists now so the
	# WebSocket path is proxied from the start; until the gateway is mounted on the
	# HTTP server this returns 502, which is the honest answer.
	handle /ws {
		reverse_proxy server:8787
	}

	# ── the client bundle ──────────────────────────────────────────────────────
	handle {
		root * /srv

		# Vite emits content-hashed filenames under /assets, so a given URL's bytes
		# never change and it can be cached indefinitely.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Everything else is index.html, which must never be cached: it is the file
		# that names the current hashed bundles, so a cached copy pins a returning
		# player to the previous deploy's JavaScript — the failure that looks like
		# "the site is broken for some people and fine for others".
		#
		# Expressed as "not hashed" rather than as `header /index.html`, because that
		# matches the *request* path: a request for `/` is served index.html but never
		# matches `/index.html`, so the rule silently missed the most common request
		# on the site. Same reasoning covers every SPA-fallback path.
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		# SPA fallback. The client has no router today (everything is at `/`), but
		# this is what makes a deep link work the moment one is added, rather than
		# 404ing in production only.
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}

# ── external: the public DNS name, Let's Encrypt ───────────────────────────────
{$SEG_SITE_ADDRESS:localhost} {
	import seg-app

	# Deliberately *not* in the shared snippet. HSTS pins a host to https in the
	# browser and makes a certificate warning unbypassable — which is exactly the
	# warning a LAN client sees until it trusts Caddy's root. Sending this header
	# from the LAN block would lock people out of the LAN address with no click-
	# through. It belongs only where the certificate is publicly trusted.
	header Strict-Transport-Security "max-age=31536000"
}

# ── internal: the LAN name/IP, Caddy's own CA ──────────────────────────────────
# Set SEG_LAN_ADDRESS to how the box is actually reached on the LAN — an IP
# (192.168.1.50), an mDNS name (seg.local), or an internal DNS name (seg.lan). The
# default, 127.0.0.1, keeps a stack with no LAN address configured from failing to start.
{$SEG_LAN_ADDRESS:127.0.0.1} {
	# Caddy's internal CA signs this one. It covers IP addresses and non-public
	# names, which is the whole reason this block exists — ACME cannot.
	tls internal

	import seg-app
}

# ── everything on :80 → https ──────────────────────────────────────────────────
# Caddy already redirects http→https for the two hosts above. This catch-all adds
# the hosts it does not know about: the other IP or name someone on the LAN happens
# to type. Without it those requests 404 on port 80 instead of being upgraded.
#
# This does not break certificate issuance: Caddy answers the ACME HTTP challenge
# before request routing, so /.well-known/acme-challenge/* is served even though
# this block claims every path.
#
# The redirect targets the default https port. If SEG_HTTPS_PORT is remapped to
# something other than 443 (the local smoke test does this), the redirect still
# points at 443 and the client has to be pointed at the real port by hand.
http:// {
	redir https://{host}{uri} 308
}
